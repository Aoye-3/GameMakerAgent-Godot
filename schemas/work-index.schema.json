{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Aoye-3/GameMakerAgent/schemas/work-index.schema.json",
  "title": "GameMaker Work Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_revision", "works"],
  "properties": {
    "schema_version": { "const": "0.1" }, "project_revision": { "type": "string", "minLength": 1 },
    "works": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["work_id", "path", "production_card", "status", "updated_at"],
        "properties": {
          "work_id": { "type": "string", "minLength": 1 }, "path": { "type": "string", "minLength": 1 },
          "production_card": { "type": "string", "minLength": 1 }, "status": { "enum": ["specified", "implemented", "verified", "failed", "insufficient_evidence"] },
          "verdict": { "enum": ["pass", "fail", "insufficient_evidence"] }, "updated_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
