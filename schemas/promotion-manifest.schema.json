{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Aoye-3/GameMakerAgent/schemas/promotion-manifest.schema.json",
  "title": "GameMaker Promotion Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "promotion_id",
    "candidate",
    "source",
    "target",
    "evidence_ids",
    "gates",
    "status"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "promotion_id": { "type": "string", "minLength": 1 },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "problem", "reusable_boundary"],
      "properties": {
        "kind": {
          "enum": ["skill", "module", "skeleton", "contract", "adapter", "debug_recipe", "benchmark"]
        },
        "name": { "type": "string", "minLength": 1 },
        "problem": { "type": "string", "minLength": 1 },
        "reusable_boundary": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "paths"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths"],
      "properties": {
        "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "compatibility_notes": { "type": "string" }
      }
    },
    "evidence_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_tests",
        "runtime_replay",
        "independent_review",
        "human_approval",
        "deprojectized",
        "license_review",
        "framework_verification"
      ],
      "properties": {
        "project_tests": { "type": "boolean" },
        "runtime_replay": { "type": "boolean" },
        "independent_review": { "type": "boolean" },
        "human_approval": { "type": "boolean" },
        "deprojectized": { "type": "boolean" },
        "license_review": { "type": "boolean" },
        "framework_verification": { "type": "boolean" }
      }
    },
    "status": { "enum": ["candidate", "reviewing", "accepted", "rejected", "superseded"] },
    "notes": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "accepted" } } },
      "then": {
        "properties": {
          "gates": {
            "properties": {
              "project_tests": { "const": true },
              "runtime_replay": { "const": true },
              "independent_review": { "const": true },
              "human_approval": { "const": true },
              "deprojectized": { "const": true },
              "license_review": { "const": true },
              "framework_verification": { "const": true }
            }
          }
        }
      }
    }
  ]
}
