{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Aoye-3/GameMakerAgent/schemas/production-card.schema.json",
  "title": "GameMaker Production Card",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "production_id", "project_context_id", "player_outcome", "beat", "reuse", "new_assets", "acceptance"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "production_id": { "type": "string", "minLength": 1 },
    "project_context_id": { "type": "string", "minLength": 1 },
    "decision_id": { "type": "string", "minLength": 1 },
    "player_outcome": { "type": "string", "minLength": 1 },
    "beat": { "type": "string", "minLength": 1 },
    "reuse": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "new_assets": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}
