{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Aoye-3/GameMakerAgent/schemas/implementation-record.schema.json",
  "title": "GameMaker Implementation Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "implementation_id", "production_id", "source_revision", "summary", "files", "binding_ids"],
  "properties": {
    "schema_version": { "const": "0.1" }, "implementation_id": { "type": "string", "minLength": 1 },
    "production_id": { "type": "string", "minLength": 1 }, "source_revision": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "files": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "binding_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}
