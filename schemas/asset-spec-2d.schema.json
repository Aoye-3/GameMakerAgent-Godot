{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Aoye-3/GameMakerAgent/schemas/asset-spec-2d.schema.json",
  "title": "GameMaker 2D Asset Spec",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "asset_id", "production_id", "role", "visual", "technical", "provenance", "normalization"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "asset_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "production_id": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "minLength": 1 },
    "visual": {
      "type": "object", "additionalProperties": false, "required": ["style", "player_read"],
      "properties": { "style": { "type": "string", "minLength": 1 }, "player_read": { "type": "string", "minLength": 1 }, "prompt": { "type": "string" } }
    },
    "technical": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "width", "height", "frames", "transparent", "pivot", "trim"],
      "properties": {
        "format": { "const": "png" },
        "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 },
        "frames": { "type": "integer", "minimum": 1 }, "transparent": { "type": "boolean" },
        "pivot": { "type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": { "x": { "type": "number", "minimum": 0, "maximum": 1 }, "y": { "type": "number", "minimum": 0, "maximum": 1 } } },
        "trim": { "type": "boolean" }, "collision_alignment": { "type": "string" }
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["source_kind", "license"],
      "properties": { "source_kind": { "enum": ["generated", "edited", "provided", "fixture"] }, "license": { "type": "string", "minLength": 1 }, "source_uri": { "type": "string" } }
    },
    "normalization": {
      "type": "object", "additionalProperties": false, "required": ["target_path"],
      "properties": { "target_path": { "type": "string", "pattern": "^res://" }, "artifact_id": { "type": "string", "minLength": 1 } }
    }
  }
}
