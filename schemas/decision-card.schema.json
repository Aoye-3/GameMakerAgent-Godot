{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Aoye-3/GameMakerAgent/schemas/decision-card.schema.json",
  "title": "GameMaker Decision Card",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "status", "player_outcome", "decision", "constraints", "source_revision"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "decision_id": { "type": "string", "minLength": 1 },
    "status": { "const": "confirmed" },
    "player_outcome": { "type": "string", "minLength": 1 },
    "decision": { "type": "string", "minLength": 1 },
    "constraints": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "validation": { "type": "string" },
    "source_revision": { "type": "string", "minLength": 1 }
  }
}
